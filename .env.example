# ════════════════════════════════════════════════════════════════
# VakaPay · Variables de entorno (PLANTILLA, sin valores reales)
# ════════════════════════════════════════════════════════════════
# En producción se ponen en Vercel → Settings → Environment Variables
# (solo «Production»), y después Deployments → Redeploy.
# En local: copia este archivo como .env y rellena los valores.
# Nunca subas el .env a GitHub ni pegues claves reales aquí.
# ────────────────────────────────────────────────────────────────

# ── Obligatorias ───────────────────────────────────────────────
# Base de datos PostgreSQL (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/vakapay
# Clave para firmar las sesiones: una cadena larga y aleatoria. Si se cambia,
# todos los usuarios tienen que volver a iniciar sesión.
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
# Puerto del servidor en local (en Vercel no hace falta)
PORT=3000

# ── Servicios (opcionales: sin ellos, esa función no está disponible) ──
# Resend: correos de bienvenida y de recuperar la contraseña
RESEND_API_KEY=
# GIPHY: buscador de GIF del chat (clave gratuita de prueba: 100 búsquedas/hora)
GIPHY_API_KEY=
# Anthropic: lectura automática de tickets
ANTHROPIC_API_KEY=
# Modelo para leer tickets (por defecto claude-haiku-5-5)
OCR_MODEL=

# ── Iniciar sesión con Google (#69) ────────────────────────────
# ID de cliente de la «Aplicación web» en Google Cloud → Google Auth Platform → Clientes.
# Termina en .apps.googleusercontent.com. Es público (no es el «secreto del cliente»).
# Sin él, el botón «Seguir con Google» dice «Próximamente».
GOOGLE_CLIENT_ID=

# ── Notificaciones push en la APK (#68) ────────────────────────
# Contenido ENTERO del .json de Firebase → Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada. Es secreto.
# Sin él no se envían notificaciones (la app funciona igual).
FIREBASE_SERVICE_ACCOUNT=

# ── Versión de la APK y mantenimiento (#73) ────────────────────
# Enlace de descarga de la APK (Google Drive, Google Play…) para el botón «Descargar»
APP_URL_DESCARGA=
# versionCode más bajo que se deja usar (android/app/build.gradle).
# Si la APK instalada es más antigua, sale «Hay una versión nueva». Vacío o 0 = sin aviso.
# No pongas un número mayor que la última APK publicada: bloquearía a todos.
APP_VERSION_MINIMA=
# Texto que se muestra en lugar de la app durante un mantenimiento (APK y web).
# Vacío = funcionamiento normal.
APP_MANTENIMIENTO=

# ── Solo para desarrollo y pruebas (no hacen falta en Vercel) ──
# Carpeta para fotos subidas en local
# UPLOADS_DIR=
